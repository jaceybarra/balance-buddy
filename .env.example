# ---------------------------------------------------------------------------
# Fantasy GM — environment configuration
# Copy to .env.local (git-ignored) and fill in. NEVER commit real values.
# ---------------------------------------------------------------------------

# Local SQLite database. Swap for a Postgres/Supabase URL later
# (and change `provider` in prisma/schema.prisma to "postgresql").
DATABASE_URL="file:./dev.db"

# --- ESPN Fantasy ----------------------------------------------------------
# Pre-filled from the league URLs. If you ever need to find them again, log into
# fantasy.espn.com, open the team, and read them out of the address bar:
#   https://fantasy.espn.com/football/team?leagueId=123456789&seasonId=2026&teamId=4
#                                                   ^leagueId               ^teamId
#
# League ids are not secrets (they are visible in the URL), but if this repo is
# public and you would rather not publish them, delete the values here and put
# them in your local .env instead — that file is git-ignored.

# Gibbs Me The Trophy
ESPN_LEAGUE_1_ID=423473861
ESPN_TEAM_1_ID=12

# So Good It Hurts
ESPN_LEAGUE_2_ID=81193741
ESPN_TEAM_2_ID=7

# The season these league ids refer to.
SEASON=2026

# Private-league cookies. Server-side only — never referenced from client code.
# DevTools > Application > Cookies > https://fantasy.espn.com
#   SWID   looks like {AAAAAAAA-BBBB-CCCC-DDDD-EEEEEEEEEEEE}  (keep the braces)
#   espn_s2 is a long URL-encoded string
ESPN_SWID=
ESPN_S2=

# Optional: separate credentials per league (falls back to ESPN_SWID/ESPN_S2).
ESPN_LEAGUE_1_SWID=
ESPN_LEAGUE_1_S2=
ESPN_LEAGUE_2_SWID=
ESPN_LEAGUE_2_S2=

# --- NFL data --------------------------------------------------------------
# Sleeper's public read APIs need no key. Set to "0" to force the offline
# mock provider (useful on a plane or when Sleeper is down).
NFL_PROVIDER=sleeper          # sleeper | mock
SLEEPER_ENABLED=1

# --- Projections -----------------------------------------------------------
# baseline = deterministic in-app model; csv = last uploaded CSV wins;
# consensus = blend of every source present.
PROJECTION_SOURCES=baseline,csv
PROJECTION_MODE=consensus     # consensus | baseline | csv

# --- Ask My GM (LLM explanation layer; optional) ---------------------------
# Without a key the app still answers questions from the deterministic engines,
# it just won't write prose. The LLM is NEVER the source of truth.
ANTHROPIC_API_KEY=
ASK_MODEL=claude-sonnet-5

# --- App behavior ----------------------------------------------------------
APP_TIMEZONE=America/Denver
# A player is "LOCKING SOON" this many minutes before kickoff.
LOCK_WARNING_MINUTES=60
# Protects the cron endpoints. Generate: openssl rand -hex 32
CRON_SECRET=
