{
  "name": "professional-impact-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Local, evidence-linked dashboard built from monthly PDF exports of a professional development document. No network calls, no external AI services.",
  "type": "module",
  "engines": { "node": ">=18.17" },
  "bin": { "portfolio": "./bin/portfolio.mjs" },
  "scripts": {
    "start": "node bin/portfolio.mjs serve",
    "serve": "node bin/portfolio.mjs serve",
    "extract": "node bin/portfolio.mjs extract",
    "ingest": "node bin/portfolio.mjs ingest",
    "validate": "node bin/portfolio.mjs validate",
    "status": "node bin/portfolio.mjs status",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {},
  "optionalDependencies": {}
}
