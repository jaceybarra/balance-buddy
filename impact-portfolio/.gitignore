# ---------------------------------------------------------------------------
# Personal data and source documents NEVER go into version control.
# ---------------------------------------------------------------------------

# Your PDF exports from the work device
source-pdfs/*
!source-pdfs/.gitkeep
*.pdf

# Extraction intermediates (they contain the full document text)
work/*
!work/.gitkeep

# Per-import analysis builders: these embed quotes, customer names and colleague
# names from the source document, so they are personal data too. build-import.mjs
# is generic infrastructure and IS committed.
tools/real-*.mjs

# The real dataset, import history, corrections and version snapshots
data/*
!data/.gitkeep

# Generated exports (they embed the dataset, so they are personal data too)
impact-summary-*.md
impact-summary-*.txt
impact-portfolio-*.html
!impact-portfolio-demo-*.html
impact-portfolio-backup-*.json

# Local noise
.DS_Store
node_modules/
*.log

# NOTE: demo/ IS committed on purpose - it is synthetic, clearly labelled,
# and never merged into data/.
